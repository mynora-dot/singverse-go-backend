# 复制为 .env；填写下面五项。不要提交实际 .env 或凭据。
# 两个镜像须已发布到此空间，前缀不带末尾斜杠。
# 例：docker.io/your_dockerhub_namespace
IMAGE_PREFIX=
# 填实际已推送的数字版本，不带 v；compute 版本不带 -openvino。
# 两者独立选版，例如主服务 0.1.0、compute 0.2.0；示例不保证远端存在。
SINGVERSE_VERSION=
COMPUTE_VERSION=
# NAS 固定局域网 IPv4 地址，例如 192.168.1.100。
SINGVERSE_HTTP_BIND=
SINGVERSE_HTTP_PORT=18080
# 在 NAS 执行 stat -c '%g' /dev/dri/renderD128，填写输出的数字。
COMPUTE_RENDER_GID=
COMPUTE_HARDWARE_DEVICE=/dev/dri/renderD128
COMPUTE_HARDWARE_BACKEND=qsv

# 8GB NAS 的初始预算；硬件性能和模型内存仍需在目标 NAS 试跑。
SINGVERSE_CONTAINER_MEMORY_LIMIT=1g
SINGVERSE_CPU_LIMIT=1.0
COMPUTE_CONTAINER_MEMORY_LIMIT=4g
COMPUTE_CPU_LIMIT=2.0
COMPUTE_PROCESS_MEMORY_BYTES=1073741824
COMPUTE_TRANSCODE_CONCURRENCY=1
COMPUTE_AUDIO_MEMORY_BYTES=2147483648
COMPUTE_AUDIO_THREADS=2
COMPUTE_AUDIO_WORKER_IDLE_SECONDS=30

# 可回收播放缓存 20GiB、计算临时缓存 5GiB；不是整个数据卷的容量上限。
SINGVERSE_SONG_CACHE_BYTES=21474836480
SINGVERSE_SONG_CACHE_MINIMUM_FREE_BYTES=2147483648
COMPUTE_CACHE_BYTES=5368709120
COMPUTE_MINIMUM_FREE_BYTES=2147483648

# 可选：使用 compose.storage.yaml 时填 NAS 上已存在的绝对路径。
# 原件只读；下载目录需要允许容器 UID/GID 10001 写入。
SINGVERSE_MEDIA_PATH=
SINGVERSE_DOWNLOAD_PATH=

# 可选：HTTPS 反向代理；普通局域网 HTTP 使用保持空白。
SINGVERSE_PUBLIC_ORIGIN=
SINGVERSE_TRUSTED_PROXIES=
