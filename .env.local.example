# Copy to .env.local and select the existing checkouts explicitly.
SINGVERSE_FRONTEND_PROJECT=/absolute/path/to/singverse-frontend
SINGVERSE_COMPUTE_PROJECT=/absolute/path/to/singverse-compute
COMPUTE_RUNTIME=base
# For phones/TVs, replace 127.0.0.1 with this machine's private LAN IP and open
# http://<that-IP>:18080/downloads/ on devices connected to the same LAN.
SINGVERSE_HTTP_BIND=127.0.0.1
SINGVERSE_HTTP_PORT=18080
COMPUTE_HTTP_BIND=127.0.0.1
COMPUTE_HTTP_PORT=18090

# Native Mac compute: set this to the Go HTTP origin reachable from macOS,
# then use make docker-macos-up (frontend/Go in Docker, compute under launchd).
# SINGVERSE_MACOS_CALLBACK_ORIGIN=http://127.0.0.1:18080

# Optional registry mirrors: preserve the pinned digest when changing the host.
# LOCAL_NODE_IMAGE=
# LOCAL_GO_IMAGE=
# LOCAL_NGINX_IMAGE=
# LOCAL_PYTHON_IMAGE=
# LOCAL_GOPROXY=https://proxy.golang.org,direct
