{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:singverse:share:5",
  "title": "SingVerse share container v5",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/records" },
    { "$ref": "#/$defs/deletionHints" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "index": {
      "type": "object",
      "properties": {
        "format": { "const": "singverse-share-set" },
        "version": { "const": 5 },
        "metadataSchema": { "const": "1.0" },
        "id": { "$ref": "#/$defs/uuid" },
        "collectionId": { "$ref": "#/$defs/uuid" },
        "collectionRevision": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "baseId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "const": "" }] },
        "total": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "records": {
          "type": "array",
          "items": { "type": "string", "pattern": "^records/[0-9]{6}\\.json$" },
          "maxItems": 30000,
          "uniqueItems": true
        },
        "deletions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^deletions/[0-9]{6}\\.json$" },
          "maxItems": 30000,
          "uniqueItems": true
        },
        "files": {
          "type": "object",
          "maxProperties": 30000,
          "propertyNames": { "pattern": "^(?:(?:records|deletions)/[0-9]{6}\\.json|assets/[0-9a-f]{64}\\.(?:jpg|png|webp|json|txt|srt|vtt))$" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sha256": { "$ref": "#/$defs/digest" },
              "size": { "type": "integer", "minimum": 1, "maximum": 33554432 }
            },
            "required": ["sha256", "size"],
            "additionalProperties": false
          }
        },
        "contentDigest": { "$ref": "#/$defs/digest" }
      },
      "required": ["format", "version", "metadataSchema", "id", "collectionId", "collectionRevision", "baseId", "total", "records", "deletions", "files", "contentDigest"],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "rootId": { "const": "media" },
          "path": { "$ref": "#/$defs/path" },
          "mediaId": { "$ref": "#/$defs/uuid" },
          "size": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
          "documents": {
            "type": "array",
            "minItems": 3,
            "maxItems": 256,
            "items": { "$ref": "urn:singverse:metadata:1.0" }
          }
        },
        "required": ["rootId", "path", "mediaId", "documents"],
        "additionalProperties": false
      }
    },
    "deletionHints": {
      "type": "object",
      "properties": {
        "advisoryOnly": { "const": true },
        "paths": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/path" } }
      },
      "required": ["advisoryOnly", "paths"]
    }
  }
}
